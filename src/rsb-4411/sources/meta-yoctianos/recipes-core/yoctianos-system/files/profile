## YoctianOS global prompt
# Run only for interactive shells
case "$-" in *i*) ;; *) return 0 ;; esac

# Detect color support
_have_color() {
  [ -t 1 ] && [ -n "${TERM:-}" ] && tput colors >/dev/null 2>&1
}
if _have_color; then
  RED="$(tput setaf 1)"
  GREEN="$(tput setaf 2)"
  BLUE="$(tput setaf 4)"
  YELLOW="$(tput setaf 3)"
  BOLD="$(tput bold)"
  RESET="$(tput sgr0)"
else
  RED="" GREEN="" BLUE="" YELLOW="" BOLD="" RESET=""
fi

# Git branch helper (fast and safe)
_git_branch() {
  # only try if inside a git directory
  if [ -d .git ] || git rev-parse --git-dir >/dev/null 2>&1; then
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [ -n "$branch" ]; then
      printf " %s(%s)%s" "$YELLOW" "$branch" "$RESET"
    fi
  fi
}

# Build PS1 for bash
if [ -n "$BASH_VERSION" ]; then
  if [ "$(id -u)" -eq 0 ]; then
    PS1="${BOLD}${RED}\\u@\\h${RESET}:${BLUE}\\w${RESET}\\$(_git_branch) # "
  else
    PS1="${BOLD}${GREEN}\\u@\\h${RESET}:${BLUE}\\w${RESET}\\$(_git_branch) \\$ "
  fi
  export PS1
fi

# Build PROMPT for zsh
if [ -n "$ZSH_VERSION" ]; then
  if [ "$(id -u)" -eq 0 ]; then
    PROMPT="%{$BOLD%}%{$RED%}%n@%m%{$RESET%}:%{$BLUE%}%~%{$RESET%}$(git_prompt_info) # "
  else
    PROMPT="%{$BOLD%}%{$GREEN%}%n@%m%{$RESET%}:%{$BLUE%}%~%{$RESET%}$(git_prompt_info) %(!.%#.$) "
  fi
  export PROMPT
fi

# Fallback for other shells
if [ -z "${PS1:-}" ] && [ -z "${PROMPT:-}" ]; then
  if [ "$(id -u)" -eq 0 ]; then
    PS1='root@\h:\w# '
  else
    PS1='\u@\h:\w\$ '
  fi
  export PS1
fi

